# Copy this file to .env and fill in your connected app's details. .env is never committed.

# Your org's My Domain, e.g. mycompany.my -- or mycompany--uat.sandbox.my for a sandbox.
# With a refresh token, login (production) or test (sandbox) work too.
SFDOMAIN=mycompany.my
SFCONSUMERKEY=
SFCONSUMERSECRET=

# Optional. Leave it empty to log in with the client credentials flow.
SFRFRESHTOKEN=
